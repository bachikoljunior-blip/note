{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasoning/LemmaUtilityPriorV1",
  "title": "LemmaUtilityPriorV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "environment",
    "eligibility",
    "observational_features",
    "generality_witness",
    "support_credit",
    "compression_proxy",
    "cost_features",
    "provenance_refs",
    "authority_scope"
  ],
  "properties": {
    "schema_version": {"const": "LemmaUtilityPriorV1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration"],
      "properties": {
        "declaration": {"type": "string", "minLength": 1},
        "source_module": {"type": ["string", "null"]},
        "declaration_digest": {"type": ["string", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "project_revision", "lean_version"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "project_revision": {"type": "string", "minLength": 1},
        "lean_version": {"type": "string", "minLength": 1},
        "evaluation_cutoff": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanical_status"],
      "properties": {
        "mechanical_status": {"enum": ["applicable", "inapplicable", "unresolved", "not_tested"]},
        "mechanical_check_ref": {"type": ["string", "null"]},
        "learned_applicability_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "observational_features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usage_count": {"type": ["integer", "null"], "minimum": 0},
        "recent_usage_count": {"type": ["integer", "null"], "minimum": 0},
        "direct_proof_use_count": {"type": ["integer", "null"], "minimum": 0},
        "transitive_dependent_count": {"type": ["integer", "null"], "minimum": 0},
        "retrieval_exposure_count": {"type": ["integer", "null"], "minimum": 0},
        "last_use_distance": {"type": ["integer", "null"], "minimum": 0},
        "reprovability_successes": {"type": ["integer", "null"], "minimum": 0},
        "reprovability_attempts": {"type": ["integer", "null"], "minimum": 0},
        "reprovability_beta11_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "generality_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["kernel_checked", "attempted_no_generalization", "not_tested", "unavailable"]},
        "tool": {"type": ["string", "null"]},
        "tool_version": {"type": ["string", "null"]},
        "successful_weakening_steps": {"type": ["integer", "null"], "minimum": 0},
        "weakened_assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "generalized_declaration_digest": {"type": ["string", "null"]}
      }
    },
    "support_credit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "estimator_kind"],
      "properties": {
        "status": {"enum": ["available", "not_evaluated", "insufficient_support"]},
        "estimator_kind": {"enum": ["exact", "sampled_frequentist", "bayesian_surrogate", "other", "not_applicable"]},
        "estimator_id": {"type": ["string", "null"]},
        "estimator_version": {"type": ["string", "null"]},
        "candidate_universe_digest": {"type": ["string", "null"]},
        "point_estimate": {"type": ["number", "null"]},
        "lower_bound": {"type": ["number", "null"]},
        "upper_bound": {"type": ["number", "null"]},
        "interval_method": {"type": ["string", "null"]},
        "confidence_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "sampling_budget": {"type": ["integer", "null"], "minimum": 0},
        "samples_observed": {"type": ["integer", "null"], "minimum": 0},
        "posterior_variance": {"type": ["number", "null"], "minimum": 0},
        "stopping_rule_id": {"type": ["string", "null"]},
        "stopping_reason": {"enum": ["exact_enumeration", "precision_reached", "max_budget", "insufficient_support", "not_applicable", null]}
      }
    },
    "compression_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "not_evaluated", "not_applicable"]},
        "method": {"type": ["string", "null"]},
        "save_value": {"type": ["number", "null"], "minimum": 0},
        "reference_count": {"type": ["integer", "null"], "minimum": 0},
        "proof_term_tree_size": {"type": ["integer", "null"], "minimum": 0},
        "source_set_digest": {"type": ["string", "null"]}
      }
    },
    "cost_features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "median_reconstruction_tokens": {"type": ["number", "null"], "minimum": 0},
        "median_reconstruction_lean_ms": {"type": ["number", "null"], "minimum": 0},
        "median_reconstruction_wall_ms": {"type": ["number", "null"], "minimum": 0},
        "estimated_retrieval_context_tokens": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "priority_score": {"type": ["number", "null"]},
    "scoring_policy_id": {"type": ["string", "null"]},
    "provenance_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_scope": {"const": "advisory_only_no_global_promotion_authority"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "support_credit": {
            "properties": {"estimator_kind": {"const": "exact"}}
          }
        },
        "required": ["support_credit"]
      },
      "then": {
        "properties": {
          "support_credit": {
            "properties": {
              "sampling_budget": {"type": "null"},
              "posterior_variance": {"type": "null"},
              "stopping_reason": {"const": "exact_enumeration"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "support_credit": {
            "properties": {"estimator_kind": {"enum": ["sampled_frequentist", "bayesian_surrogate"]}}
          }
        },
        "required": ["support_credit"]
      },
      "then": {
        "properties": {
          "support_credit": {
            "required": ["estimator_id", "sampling_budget", "samples_observed", "stopping_rule_id"]
          }
        }
      }
    }
  ]
}
