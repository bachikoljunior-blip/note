{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasoning/UseEventV0",
  "title": "UseEventV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "observed_at",
    "environment",
    "target",
    "candidate",
    "relation_kind",
    "directness",
    "observation_method",
    "provenance_refs",
    "causal_interpretation"
  ],
  "properties": {
    "schema_version": {"const": "UseEventV0"},
    "event_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "project_revision", "lean_version"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "project_revision": {"type": "string", "minLength": 1},
        "lean_version": {"type": "string", "minLength": 1},
        "dependency_snapshot_digest": {"type": ["string", "null"]}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration"],
      "properties": {
        "declaration": {"type": "string", "minLength": 1},
        "source_module": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration"],
      "properties": {
        "declaration": {"type": "string", "minLength": 1},
        "source_module": {"type": ["string", "null"]}
      }
    },
    "relation_kind": {
      "enum": [
        "statement_dependency",
        "proof_term_dependency",
        "explicit_tactic_reference",
        "retrieved_exposure"
      ]
    },
    "directness": {"enum": ["direct", "transitive", "not_applicable"]},
    "observation_method": {
      "enum": [
        "dependency_graph",
        "final_proof_term",
        "source_or_elaboration_trace",
        "retrieval_log",
        "other"
      ]
    },
    "proof_artifact": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["artifact_digest", "survives_final_proof_term"],
      "properties": {
        "artifact_digest": {"type": ["string", "null"]},
        "survives_final_proof_term": {"type": ["boolean", "null"]}
      }
    },
    "source_reference": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1}
      }
    },
    "retrieval_exposure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "query_id": {"type": "string"},
        "rank": {"type": "integer", "minimum": 1},
        "score": {"type": ["number", "null"]}
      }
    },
    "provenance_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "causal_interpretation": {"const": "observational_only"}
  }
}
