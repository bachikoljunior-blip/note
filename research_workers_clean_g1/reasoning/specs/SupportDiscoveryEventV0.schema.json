{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasoning/SupportDiscoveryEventV0",
  "title": "SupportDiscoveryEventV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "observed_at",
    "environment",
    "target_declaration",
    "candidate_universe_digest",
    "alternative_support_family_id",
    "support_id",
    "support_declarations",
    "discovery",
    "budget",
    "replay_verified",
    "minimality_scope",
    "family_completeness",
    "provenance_refs"
  ],
  "properties": {
    "schema_version": {"const": "SupportDiscoveryEventV0"},
    "event_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_assistant", "project", "project_revision"],
      "properties": {
        "proof_assistant": {"enum": ["Lean", "Isabelle", "Coq", "other"]},
        "project": {"type": "string", "minLength": 1},
        "project_revision": {"type": "string", "minLength": 1},
        "toolchain_version": {"type": ["string", "null"]}
      }
    },
    "target_declaration": {"type": "string", "minLength": 1},
    "candidate_universe_digest": {"type": "string", "minLength": 1},
    "alternative_support_family_id": {"type": "string", "minLength": 1},
    "support_id": {"type": "string", "minLength": 1},
    "support_declarations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "prover_or_method", "version"],
      "properties": {
        "route": {
          "enum": [
            "sledgehammer_proof",
            "prover_minimization",
            "hitting_set_branch",
            "manual_replay",
            "deterministic_fixture",
            "other"
          ]
        },
        "prover_or_method": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "seed": {"type": ["integer", "string", "null"]},
        "parent_support_id": {"type": ["string", "null"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_ms": {"type": ["integer", "null"], "minimum": 0},
        "max_proofs": {"type": ["integer", "null"], "minimum": 1},
        "max_facts": {"type": ["integer", "null"], "minimum": 1},
        "token_budget": {"type": ["integer", "null"], "minimum": 0},
        "other_budget_note": {"type": ["string", "null"]}
      }
    },
    "replay_verified": {"type": "boolean"},
    "minimality_scope": {
      "enum": [
        "prover_relative_subset_minimal",
        "fixture_exact_subset_minimal",
        "not_minimized",
        "unknown"
      ]
    },
    "family_completeness": {
      "enum": ["sampled_non_exhaustive", "exhaustive_for_frozen_universe", "unknown"]
    },
    "provenance_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
