{
  "$defs": {
    "sha": {
      "pattern": "^[0-9a-fA-F]{40}$",
      "type": "string"
    }
  },
  "$id": "phase1-open-source-policy-evidence-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "candidate": {
      "additionalProperties": true,
      "properties": {
        "head_sha": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "head_sha"
      ],
      "type": "object"
    },
    "completeness": {
      "additionalProperties": {
        "type": "boolean"
      },
      "properties": {
        "policy_inventory": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_inventory"
      ],
      "type": "object"
    },
    "families": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "applicable": {
            "type": "boolean"
          },
          "blocking_findings": {
            "type": "array"
          },
          "completeness": {
            "type": "object"
          },
          "evidence": {
            "type": "object"
          },
          "family": {
            "enum": [
              "pull_request_reviews",
              "required_status_checks",
              "required_workflows",
              "required_deployments",
              "required_signatures",
              "code_scanning",
              "code_quality",
              "code_coverage",
              "merge_queue"
            ]
          },
          "policy_raw": {
            "type": "object"
          },
          "requirements": {
            "type": "object"
          }
        },
        "required": [
          "family",
          "applicable"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 2
    }
  },
  "required": [
    "schema_version",
    "candidate",
    "completeness",
    "families"
  ],
  "title": "Fail-closed GitHub policy evidence v2",
  "type": "object",
  "x_phase1_contract": {
    "pull_request_reviews": {
      "raw_copilot_key": "policy_raw.parameters.require_extra_approval_for_unattributed_changes",
      "required_reviewer_pattern_engine": "evidence.required_reviewer_pattern_engine must equal ordered_gitignore_negation when required_reviewers include file_patterns",
      "rest_pull_files_cap": "changed_paths_source=rest_pull_files with changed_file_count>3000 is UNKNOWN"
    },
    "required_workflows": {
      "policy_identity_fields": [
        "repository_id",
        "path",
        "ref?",
        "sha?"
      ],
      "rule": "PASS requires at least one success run matching every required source identity and exact target head",
      "run_evidence_fields": [
        "target_head_sha",
        "source_repository_id",
        "source_path",
        "source_ref?",
        "source_sha?",
        "conclusion"
      ]
    }
  }
}