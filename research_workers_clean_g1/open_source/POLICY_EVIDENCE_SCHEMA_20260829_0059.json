{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase1-open-source-policy-evidence-schema-v1",
  "title": "GitHub policy evidence verifier normalized input",
  "type": "object",
  "required": [
    "schema_version",
    "candidate",
    "completeness",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage": {
      "enum": [
        "pre_enqueue",
        "post_enqueue"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "head_sha"
      ],
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "merge_group_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      },
      "additionalProperties": true
    },
    "completeness": {
      "type": "object",
      "required": [
        "policy_inventory"
      ],
      "properties": {
        "policy_inventory": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "family",
          "applicable",
          "completeness",
          "evidence"
        ],
        "properties": {
          "family": {
            "enum": [
              "required_status_checks",
              "required_workflows",
              "required_deployments",
              "pull_request_reviews",
              "required_signatures",
              "code_scanning",
              "code_quality",
              "code_coverage",
              "merge_queue"
            ]
          },
          "applicable": {
            "type": "boolean"
          },
          "requirements": {
            "type": "object"
          },
          "completeness": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "evidence": {
            "type": "object"
          },
          "blocking_findings": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "definitive"
                  ],
                  "properties": {
                    "definitive": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
