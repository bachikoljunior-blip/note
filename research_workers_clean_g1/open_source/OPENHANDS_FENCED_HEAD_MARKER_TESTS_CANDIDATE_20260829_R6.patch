+@pytest.mark.asyncio
+async def test_markerless_tail_event_is_not_auto_adopted(tmp_path):
+    """A unique descendant without a durable commit marker is not write intent.
+
+    This protects intentional navigation/fork semantics: startup recovery must
+    never infer the active branch merely because only one newer event file is
+    present.  The existing persisted non-null HEAD remains authoritative when
+    no pending-HEAD marker binds a transition.
+    """
+    conversations_dir = tmp_path / "conversations"
+    workspace_dir = tmp_path / "workspace"
+    workspace_dir.mkdir()
+
+    async with ConversationService(conversations_dir=conversations_dir) as primary:
+        conversation_info, _ = await primary.start_conversation(_request(workspace_dir))
+        assert primary._event_services is not None
+        service = primary._event_services[conversation_info.id]
+        state = await service.get_state()
+        conversation_dir = conversations_dir / conversation_info.id.hex
+
+        await service.send_message(
+            Message(role="user", content=[TextContent(text="committed head")]),
+            run=False,
+        )
+        committed_leaf = state.leaf_event_id
+        assert committed_leaf is not None
+
+        # Simulate an unrelated/orphan immutable log record without going through
+        # append_event, hence without a pending-HEAD marker.  EventLog is append-
+        # only storage; this record alone must not authorize moving HEAD.
+        orphan = MessageEvent(
+            source="user",
+            parent_id=committed_leaf,
+            llm_message=Message(
+                role="user", content=[TextContent(text="markerless orphan")]
+            ),
+        )
+        state.events.append(orphan)
+        assert any(event.id == orphan.id for event in _load_disk_events(conversation_dir))
+        assert not list((conversation_dir / "pending_head_commits").glob("*.json"))
+
+        _expire_lease(conversation_dir)
+
+        async with ConversationService(conversations_dir=conversations_dir) as secondary:
+            recovered = secondary._event_services[conversation_info.id]
+            recovered_state = await recovered.get_state()
+            assert recovered_state.leaf_event_id == committed_leaf
+            assert orphan.id not in {
+                event.id for event in recovered_state.active_branch()
+            }
+
