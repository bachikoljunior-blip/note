+                )
+            if self._head_event_digest(event) != marker.get("event_sha256"):
+                raise ValueError(
+                    f"Pending HEAD marker digest mismatch for event {event_id}"
+                )
+            pending[event_id] = (path, marker)
+
+        adopted: list[EventID] = []
+        while pending:
+            candidates = [
+                event_id
+                for event_id, (_, marker) in pending.items()
+                if marker.get("expected_leaf_event_id") == self.leaf_event_id
+                and bool(marker.get("expected_head_is_empty"))
+                == self.head_is_empty
+            ]
+            if not candidates:
+                break
+            if len(candidates) != 1:
+                raise ValueError(
+                    "Ambiguous pending HEAD commit chain; refusing to choose a branch"
+                )
+
+            event_id = candidates[0]
+            event = self._events[self._events.get_index(event_id)]
+            self.leaf_event_id = event_id
+            if self.head_is_empty:
+                self.head_is_empty = False
+            if isinstance(event, MessageEvent) and event.source == "user":
+                self.last_user_message_id = event.id
+            adopted.append(event_id)
+            pending.pop(event_id)
+
+        if pending:
+            raise ValueError(
+                "Pending HEAD marker is not reachable from the exact persisted HEAD"
+            )
+
+        if adopted:
+            # Commit reconstructed HEAD/last_user_message_id before returning.
+            # _save_base_state increments persistence_generation; marker cleanup
+            # after that point is idempotent across another crash.
+            self._save_base_state(self._fs)
+        return adopted
 
