+    def reconcile_pending_head_commits(self) -> list[EventID]:
+        """Finish only an exact marker-bound event->HEAD commit chain.
+
+        This intentionally does *not* adopt a unique log descendant merely
+        because it exists. Marker identity, the persisted raw HEAD state,
+        event parent and exact event digest must all agree. Multiple candidates
+        from the same expected HEAD fail closed, preserving intentional forks.
+
+        Callers that use an external writer lease must install set_write_guard()
+        before invoking this method.
+        """
+        marker_paths = self._fs.list(PENDING_HEAD_COMMITS_DIR)
+        if not marker_paths:
+            return []
+
+        pending: dict[EventID, tuple[str, dict[str, object]]] = {}
+        for path in marker_paths:
+            marker = json.loads(self._fs.read(path))
+            marker_generation = int(marker["base_generation"])
+            if marker_generation < self.persistence_generation:
+                # A later base snapshot definitely committed; this is cleanup
+                # residue, not an unapplied event->HEAD transition.
+                guard = (
+                    nullcontext()
+                    if self._write_guard is None
+                    else self._write_guard()
+                )
+                with guard:
+                    self._fs.delete(path)
+                continue
+            if marker_generation > self.persistence_generation:
+                raise ValueError(
+                    "Pending HEAD marker has a future persistence generation"
+                )
+
+            event_id = str(marker["event_id"])
+            if event_id not in self._events:
+                # Marker-before-event crash: no durable event exists to adopt.
+                guard = (
+                    nullcontext()
+                    if self._write_guard is None
+                    else self._write_guard()
+                )
+                with guard:
+                    self._fs.delete(path)
+                continue
+
+            event = self._events[self._events.get_index(event_id)]
+            if event.parent_id != marker.get("parent_id"):
+                raise ValueError(
