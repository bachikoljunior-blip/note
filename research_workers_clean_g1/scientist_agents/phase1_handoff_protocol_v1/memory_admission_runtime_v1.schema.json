{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_admission_runtime_v1.schema.json",
  "title": "Validated failure-memory runtime admission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_context_digest",
    "admission_policy_revision",
    "candidates",
    "runtime"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "admission_context_digest": {"type": "string", "minLength": 8},
    "admission_policy_revision": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "validated_packet_digest", "receiver_decision"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "validated_packet_digest": {"type": "string", "minLength": 8},
          "receiver_decision": {"enum": ["adopt", "reject", "hold"]}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_context_digest",
        "selection_policy_revision",
        "fallback_policy",
        "selected_memory"
      ],
      "properties": {
        "selection_context_digest": {"type": "string", "minLength": 8},
        "selection_policy_revision": {"type": "string", "minLength": 1},
        "fallback_policy": {
          "enum": ["allow_empty", "baseline_without_memory", "force_nonempty"]
        },
        "selected_memory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "validated_packet_digest"],
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "validated_packet_digest": {"type": "string", "minLength": 8}
            }
          }
        }
      }
    }
  }
}
