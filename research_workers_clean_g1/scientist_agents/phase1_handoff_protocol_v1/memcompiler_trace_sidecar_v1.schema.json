{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memcompiler_trace_sidecar_v1.schema.json",
  "title": "MemCompiler bounded selection provenance sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "implementation",
    "evaluation_input",
    "memory_source",
    "retrieval_snapshot",
    "memory_updates_frozen",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "runner_path"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7},
        "runner_path": {"type": "string", "minLength": 1}
      }
    },
    "evaluation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_text_sha256", "dataset_path", "dataset_blob_or_sha256"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_path": {"type": "string", "minLength": 1},
        "dataset_blob_or_sha256": {"type": "string", "minLength": 7}
      }
    },
    "memory_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memcompiler_path_id", "memory_database_sha256", "compiler_artifact_id", "compiler_artifact_revision_or_digest"],
      "properties": {
        "memcompiler_path_id": {"type": "string", "minLength": 1},
        "memory_database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiler_artifact_id": {"type": "string", "minLength": 1},
        "compiler_artifact_revision_or_digest": {"type": "string", "minLength": 1}
      }
    },
    "retrieval_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_query_sha256", "retrieval_config_sha256", "candidate_pool", "candidate_pool_digest"],
      "properties": {
        "retrieval_query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "retrieval_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_pool": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["memory_id", "content_sha256"],
            "properties": {
              "memory_id": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "candidate_pool_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "memory_updates_frozen": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_index",
          "state_revision",
          "state_sha256",
          "brief_state_sha256",
          "candidate_pool_digest",
          "selector_policy_revision_or_digest",
          "selected_memory",
          "output_type",
          "compiled_guidance_sha256",
          "selector_output_sha256",
          "receiver_effect",
          "executor_input_sha256"
        ],
        "properties": {
          "step_index": {"type": "integer", "minimum": 0},
          "state_revision": {"type": "string", "minLength": 1},
          "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "brief_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "candidate_pool_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "selector_policy_revision_or_digest": {"type": "string", "minLength": 1},
          "selected_memory": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["memory_id", "content_sha256"],
              "properties": {
                "memory_id": {"type": "string", "minLength": 1},
                "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "output_type": {"enum": ["EXPERIENCE", "BRIEF", "HYBRID", "NOACTION"]},
          "compiled_guidance_sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "selector_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "receiver_effect": {"enum": ["inject", "abstain"]},
          "executor_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
