{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scientist-agents:paired-intervention-randomness-provider-binding:v1",
  "title": "Paired Intervention Randomness and Provider Binding Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "bundle_id",
    "source_revision",
    "dataset_manifest_digest",
    "candidate_intervention_digest",
    "inference_contract",
    "judge_contract",
    "pairs",
    "summary"
  ],
  "properties": {
    "protocol_version": {
      "const": "p1-protocol-063-v1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "dataset_manifest_digest": {
      "$ref": "#/$defs/digest"
    },
    "candidate_intervention_digest": {
      "$ref": "#/$defs/digest"
    },
    "inference_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_revision",
        "provider_execution_revision",
        "decoding_config_digest",
        "randomness_control"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "provider_execution_revision": {
          "type": "string",
          "minLength": 1
        },
        "decoding_config_digest": {
          "$ref": "#/$defs/digest"
        },
        "randomness_control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "evidence_digest"
          ],
          "properties": {
            "method": {
              "enum": [
                "explicit_seed",
                "captured_rng_state",
                "replay_equivalence",
                "temperature_zero",
                "selection_seed_only"
              ]
            },
            "evidence_digest": {
              "$ref": "#/$defs/digest"
            },
            "inference_seed": {
              "type": "integer",
              "minimum": 0
            },
            "provider_seed_semantics_digest": {
              "$ref": "#/$defs/digest"
            },
            "rng_state_digest": {
              "$ref": "#/$defs/digest"
            },
            "replay_equivalence_digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    "judge_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judge_id",
        "judge_revision",
        "judge_config_digest"
      ],
      "properties": {
        "judge_id": {
          "type": "string",
          "minLength": 1
        },
        "judge_revision": {
          "type": "string",
          "minLength": 1
        },
        "judge_config_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "instance_digest",
          "environment_snapshot_digest",
          "baseline",
          "intervention"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "instance_digest": {
            "$ref": "#/$defs/digest"
          },
          "environment_snapshot_digest": {
            "$ref": "#/$defs/digest"
          },
          "baseline": {
            "$ref": "#/$defs/arm"
          },
          "intervention": {
            "$ref": "#/$defs/arm"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_pairs",
        "baseline_successes",
        "intervention_successes",
        "repair_count",
        "regression_count",
        "net_gain"
      ],
      "properties": {
        "n_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_successes": {
          "type": "integer",
          "minimum": 0
        },
        "intervention_successes": {
          "type": "integer",
          "minimum": 0
        },
        "repair_count": {
          "type": "integer",
          "minimum": 0
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "net_gain": {
          "type": "integer"
        }
      }
    },
    "dataset_selection_seed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_effect",
        "injected_intervention_digest",
        "trajectory_digest",
        "inference_request_digest",
        "inference_response_digest",
        "randomness_evidence_digest",
        "success"
      ],
      "properties": {
        "receiver_effect": {
          "enum": [
            "absent",
            "present"
          ]
        },
        "injected_intervention_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "trajectory_digest": {
          "$ref": "#/$defs/digest"
        },
        "inference_request_digest": {
          "$ref": "#/$defs/digest"
        },
        "inference_response_digest": {
          "$ref": "#/$defs/digest"
        },
        "randomness_evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "success": {
          "type": "boolean"
        }
      }
    }
  }
}
