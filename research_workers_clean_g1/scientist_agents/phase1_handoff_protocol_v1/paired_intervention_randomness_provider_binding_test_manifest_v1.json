    {"name":"reject_temperature_zero_as_randomness_binding","expected_accept":false,"expected_primary_error":"temperature_zero_is_not_inference_randomness_binding"},
    {"name":"reject_missing_provider_seed_semantics","expected_accept":false,"expected_primary_error":"explicit_seed_requires_inference_seed_and_provider_seed_semantics_digest"},
    {"name":"accept_captured_rng_state","expected_accept":true,"expected_primary_error":null},
    {"name":"accept_replay_equivalence","expected_accept":true,"expected_primary_error":null},
    {"name":"reject_floating_model_revision","expected_accept":false,"expected_primary_error":"model_revision_must_be_immutable_not_floating"},
    {"name":"reject_floating_provider_execution_revision","expected_accept":false,"expected_primary_error":"provider_execution_revision_must_be_immutable_not_floating"},
    {"name":"reject_rng_evidence_drift","expected_accept":false,"expected_primary_error":"pair[1]:randomness_evidence_not_common_binding"},
    {"name":"reject_baseline_injects_intervention","expected_accept":false,"expected_primary_error":"pair[0]:baseline_must_not_inject_intervention"},
    {"name":"reject_intervention_digest_mismatch","expected_accept":false,"expected_primary_error":"pair[0]:intervention_digest_mismatch"},
    {"name":"reject_duplicate_instance_id","expected_accept":false,"expected_primary_error":"duplicate_instance_id:i1"},
    {"name":"reject_request_digest_not_changed_by_effect","expected_accept":false,"expected_primary_error":"pair[0]:request_digest_must_reflect_intervention_delta"},
    {"name":"reject_trajectory_digest_reuse","expected_accept":false,"expected_primary_error":"pair[0]:trajectory_digest_reused_across_arms"},
