{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/scientist_agents/reviewer_input_snapshot_archive_coherence_v1.schema.json",
  "title":"Reviewer input snapshot and archive coherence gate",
  "type":"object","additionalProperties":false,
  "required":["schema_version","evaluator","input_manifest","observed_item_ids","archive","verdict","reevaluation"],
  "properties":{
    "schema_version":{"const":1},
    "evaluator":{"$ref":"#/$defs/evaluator"},
    "input_manifest":{"$ref":"#/$defs/manifest"},
    "observed_item_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "archive":{"$ref":"#/$defs/archive"},
    "verdict":{"$ref":"#/$defs/verdict"},
    "reevaluation":{"$ref":"#/$defs/reeval"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitsha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "evaluator":{
      "type":"object","additionalProperties":false,
      "required":["repository","revision","runner_artifact_sha256","model_identity","prompt_sha256","policy_revision"],
      "properties":{
        "repository":{"type":"string","minLength":1},
        "revision":{"$ref":"#/$defs/gitsha"},
        "runner_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "model_identity":{"type":"string","minLength":1},
        "prompt_sha256":{"$ref":"#/$defs/sha256"},
        "policy_revision":{"type":"string","minLength":1}
      }
    },
    "item":{
      "type":"object","additionalProperties":false,
      "required":["item_id","role","path_hint","content_sha256"],
      "properties":{
        "item_id":{"type":"string","minLength":1},
        "role":{"enum":["trace","produced_artifact","analysis","claim_input","claim_reference","reference_impl","environment_manifest","other"]},
        "path_hint":{"type":"string","minLength":1},
        "content_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "manifest":{
      "type":"object","additionalProperties":false,
      "required":["manifest_sha256","items"],
      "properties":{
        "manifest_sha256":{"$ref":"#/$defs/sha256"},
        "items":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/item"}}
      }
    },
    "externalRef":{
      "type":"object","additionalProperties":false,
      "required":["item_id","locator","content_sha256","content_addressed","resolvable"],
      "properties":{
        "item_id":{"type":"string","minLength":1},
        "locator":{"type":"string","minLength":1},
        "content_sha256":{"$ref":"#/$defs/sha256"},
        "content_addressed":{"type":"boolean"},
        "resolvable":{"type":"boolean"}
      }
    },
    "archive":{
      "type":"object","additionalProperties":false,
      "required":["mode","archive_manifest_sha256","embedded_item_ids","external_refs"],
      "properties":{
        "mode":{"enum":["self_contained","thin"]},
        "archive_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "embedded_item_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "external_refs":{"type":"array","items":{"$ref":"#/$defs/externalRef"}}
      }
    },
    "verdict":{
      "type":"object","additionalProperties":false,
      "required":["input_manifest_sha256","verdict_artifact_sha256","overall_score"],
      "properties":{
        "input_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "verdict_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "overall_score":{"type":"integer","minimum":1,"maximum":5}
      }
    },
    "reeval":{
      "type":"object","additionalProperties":false,
      "required":["previous_verdict_artifact_sha256","previous_input_manifest_sha256","reuse_previous_verdict"],
      "properties":{
        "previous_verdict_artifact_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "previous_input_manifest_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
        "reuse_previous_verdict":{"type":"boolean"}
      }
    }
  }
}
