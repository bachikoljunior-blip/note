{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_memory_compatibility_v1.schema.json",
  "title": "Per-decision memory compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_snapshot_digest", "compatibility_policy_revision", "decision_step_id", "state", "candidates", "runtime"],
  "properties": {
    "schema_version": {"const": 1},
    "memory_snapshot_digest": {"type": "string", "minLength": 8},
    "compatibility_policy_revision": {"type": "string", "minLength": 1},
    "decision_step_id": {"type": "string", "minLength": 1},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_revision", "state_signature_digest"],
      "properties": {
        "state_revision": {"type": "string", "minLength": 1},
        "state_signature_digest": {"type": "string", "minLength": 8}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "validated_packet_digest", "creation_state_signature_digest", "compatibility"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "validated_packet_digest": {"type": "string", "minLength": 8},
          "creation_state_signature_digest": {"type": "string", "minLength": 8},
          "compatibility": {"enum": ["compatible", "incompatible"]}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_memory_snapshot_digest", "checked_policy_revision", "checked_state_revision", "checked_state_signature_digest", "checked_candidate_set_digest", "current_candidate_set_digest", "injected_memory"],
      "properties": {
        "checked_memory_snapshot_digest": {"type": "string", "minLength": 8},
        "checked_policy_revision": {"type": "string", "minLength": 1},
        "checked_state_revision": {"type": "string", "minLength": 1},
        "checked_state_signature_digest": {"type": "string", "minLength": 8},
        "checked_candidate_set_digest": {"type": "string", "minLength": 8},
        "current_candidate_set_digest": {"type": "string", "minLength": 8},
        "injected_memory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "validated_packet_digest"],
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "validated_packet_digest": {"type": "string", "minLength": 8}
            }
          }
        }
      }
    }
  }
}
