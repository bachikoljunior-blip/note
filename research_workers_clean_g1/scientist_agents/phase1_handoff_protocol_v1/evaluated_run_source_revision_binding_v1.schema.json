{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/evaluated_run_source_revision_binding_v1.schema.json",
  "title": "Evaluated Run Source Revision Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","claim","publication","evaluated_implementation","run_manifest","cases","authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "claim": {"type":"object","additionalProperties":false,"required":["claim_id","expected_case_count","claim_edition"],"properties":{"claim_id":{"type":"string","minLength":1},"expected_case_count":{"type":"integer","minimum":1},"claim_edition":{"type":"string","minLength":1}}},
    "publication": {"type":"object","additionalProperties":false,"required":["published_at","artifact_sha256"],"properties":{"published_at":{"type":"string","format":"date-time"},"artifact_sha256":{"$ref":"#/$defs/sha256"}}},
    "evaluated_implementation": {"type":"object","additionalProperties":false,"required":["edition","source_identity_type","source_identity","source_tree_sha256","claim_gate_revision","source_first_public_at","bridge"],"properties":{"edition":{"type":"string","minLength":1},"source_identity_type":{"enum":["git_commit","git_tree","source_archive"]},"source_identity":{"type":"string","minLength":7},"source_tree_sha256":{"$ref":"#/$defs/sha256"},"claim_gate_revision":{"type":"string","minLength":1},"source_first_public_at":{"type":"string","format":"date-time"},"bridge":{"type":"object","additionalProperties":false,"required":["present"],"properties":{"present":{"type":"boolean"},"evaluated_source_bundle_sha256":{"$ref":"#/$defs/sha256"},"bridge_statement_sha256":{"$ref":"#/$defs/sha256"}}}}},
    "run_manifest": {"type":"object","additionalProperties":false,"required":["kind","manifest_sha256","source_tree_sha256","claim_gate_revision","case_ids"],"properties":{"kind":{"enum":["evaluated_run_manifest","dataset_manifest"]},"manifest_sha256":{"$ref":"#/$defs/sha256"},"source_tree_sha256":{"$ref":"#/$defs/sha256"},"claim_gate_revision":{"type":"string","minLength":1},"case_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true,"minItems":1}}},
    "cases": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["case_id","model_id","input_manifest_sha256","execution_trace_sha256","result_artifact_sha256","gate_report_sha256"],"properties":{"case_id":{"type":"string","minLength":1},"model_id":{"type":"string","minLength":1},"input_manifest_sha256":{"$ref":"#/$defs/sha256"},"execution_trace_sha256":{"$ref":"#/$defs/sha256"},"result_artifact_sha256":{"$ref":"#/$defs/sha256"},"gate_report_sha256":{"$ref":"#/$defs/sha256"}}}},
    "authorization": {"type":"object","additionalProperties":false,"required":["requested_level","edition_equivalence_proof_sha256"],"properties":{"requested_level":{"enum":["mechanism_only","evaluated_run_bound","cross_edition_certificate"]},"edition_equivalence_proof_sha256":{"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]}}}
  },
  "$defs": {"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
