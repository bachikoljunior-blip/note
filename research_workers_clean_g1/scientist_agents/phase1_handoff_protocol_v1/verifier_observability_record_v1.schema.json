{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.scientist-agents/verifier_observability_record_v1.schema.json",
  "title": "Verifier Observability Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id",
    "claim_id",
    "claim_evidence_requirements",
    "visible_evidence",
    "coverage_status",
    "disposition",
    "falsifying_evidence",
    "evidence_requirement_digest",
    "visible_evidence_digest",
    "cached_authorization"
  ],
  "properties": {
    "verification_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "visible_evidence": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]+$"}
    },
    "coverage_status": {"enum": ["complete", "partial", "uninspectable"]},
    "disposition": {"enum": ["PROCEED", "HOLD", "REQUEST_EVIDENCE", "UNINSPECTABLE", "REJECT", "BLOCK", "PRUNE", "FORBID"]},
    "falsifying_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "type", "evidence_digest"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "type": {"enum": ["contradiction", "deterministic_test_failure", "explicit_falsification"]},
          "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]+$"}
        }
      }
    },
    "evidence_requirement_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]+$"},
    "visible_evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]+$"},
    "cached_authorization": {"type": "boolean"}
  }
}
