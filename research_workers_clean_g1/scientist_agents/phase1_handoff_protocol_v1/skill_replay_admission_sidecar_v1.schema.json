{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scientist_agents/skill_replay_admission_sidecar_v1.schema.json",
  "title": "ScienceWorld skill replay admission provenance sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","claim_level","implementation","environment","transaction","replays","decision"],
  "properties": {
    "schema_version": {"const": 1},
    "claim_level": {"enum": ["transaction_only","replay_verified_admission"]},
    "implementation": {"$ref": "#/$defs/implementation"},
    "environment": {"$ref": "#/$defs/environment"},
    "transaction": {"$ref": "#/$defs/transaction"},
    "replays": {"type":"array","items":{"$ref":"#/$defs/replay"}},
    "decision": {"$ref":"#/$defs/decision"}
  },
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitsha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "implementation": {
      "type":"object","additionalProperties":false,
      "required":["repository","revision","asisleep_blob_sha","config_blob_sha","policy_revision"],
      "properties": {
        "repository":{"type":"string","minLength":1},
        "revision":{"$ref":"#/$defs/gitsha"},
        "asisleep_blob_sha":{"$ref":"#/$defs/gitsha"},
        "config_blob_sha":{"$ref":"#/$defs/gitsha"},
        "policy_revision":{"type":"string","minLength":1}
      }
    },
    "environment": {
      "type":"object","additionalProperties":false,
      "required":["package","version","artifact_filename","artifact_sha256","dataset_manifest_sha256","replay_equivalence_packet_sha256"],
      "properties": {
        "package":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "artifact_filename":{"type":"string","minLength":1},
        "artifact_sha256":{"$ref":"#/$defs/sha256"},
        "dataset_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "replay_equivalence_packet_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]}
      }
    },
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["name","code_sha256"],
      "properties":{"name":{"type":"string","minLength":1},"code_sha256":{"$ref":"#/$defs/sha256"}}
    },
    "transaction": {
      "type":"object","additionalProperties":false,
      "required":["batch_index","successful_task_ids","allow_replay","pre_codebook_sha256","candidate_codebook_sha256","candidate_functions"],
      "properties": {
        "batch_index":{"type":"integer","minimum":0},
        "successful_task_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "allow_replay":{"type":"boolean"},
        "pre_codebook_sha256":{"$ref":"#/$defs/sha256"},
        "candidate_codebook_sha256":{"$ref":"#/$defs/sha256"},
        "candidate_functions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/candidate"}}
      }
    },
    "replay": {
      "type":"object","additionalProperties":false,
      "required":["task_id","problem_record_sha256","reset_observation_sha256","test_trajectory_artifact_sha256","test_trajectory_digest","used_new_helper","solution_success","result_artifact_sha256"],
      "properties": {
        "task_id":{"type":"string","minLength":1},
        "problem_record_sha256":{"$ref":"#/$defs/sha256"},
        "reset_observation_sha256":{"$ref":"#/$defs/sha256"},
        "test_trajectory_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "test_trajectory_digest":{"$ref":"#/$defs/sha256"},
        "used_new_helper":{"type":"boolean"},
        "solution_success":{"type":"boolean"},
        "error_class":{"type":["string","null"]},
        "result_artifact_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "decision": {
      "type":"object","additionalProperties":false,
      "required":["status","post_codebook_sha256","decision_packet_sha256"],
      "properties": {
        "status":{"enum":["commit","revert"]},
        "post_codebook_sha256":{"$ref":"#/$defs/sha256"},
        "decision_packet_sha256":{"$ref":"#/$defs/sha256"}
      }
    }
  }
}
