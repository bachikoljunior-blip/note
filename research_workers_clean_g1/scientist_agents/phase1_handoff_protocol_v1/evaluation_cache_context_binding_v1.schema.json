{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scientist_agents/evaluation_cache_context_binding_v1.schema.json",
  "title": "Evaluation cache context binding gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","claim_scope","entry_context","current_context","cache_entry","reuse_request"],
  "properties": {
    "schema_version": {"const": 1},
    "claim_scope": {"const": "empty_codebook_rollout_cache"},
    "entry_context": {"$ref": "#/$defs/context"},
    "current_context": {"$ref": "#/$defs/context"},
    "cache_entry": {"$ref": "#/$defs/cacheEntry"},
    "reuse_request": {"$ref": "#/$defs/reuseRequest"}
  },
  "$defs": {
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitsha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "context": {
      "type":"object","additionalProperties":false,
      "required":["runner_revision","runner_artifact_sha256","environment_artifact_sha256","environment_transition_contract_sha256","dataset_record_sha256","codebook_sha256","system_prompt_sha256","user_prompt_sha256","generation_config_sha256","backend_fingerprint_sha256","sampling_contract_sha256","cache_policy_revision"],
      "properties": {
        "runner_revision":{"$ref":"#/$defs/gitsha"},
        "runner_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "environment_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "environment_transition_contract_sha256":{"$ref":"#/$defs/sha256"},
        "dataset_record_sha256":{"$ref":"#/$defs/sha256"},
        "codebook_sha256":{"$ref":"#/$defs/sha256"},
        "system_prompt_sha256":{"$ref":"#/$defs/sha256"},
        "user_prompt_sha256":{"$ref":"#/$defs/sha256"},
        "generation_config_sha256":{"$ref":"#/$defs/sha256"},
        "backend_fingerprint_sha256":{"$ref":"#/$defs/sha256"},
        "sampling_contract_sha256":{"$ref":"#/$defs/sha256"},
        "cache_policy_revision":{"type":"string","minLength":1}
      }
    },
    "cacheEntry": {
      "type":"object","additionalProperties":false,
      "required":["cache_key_sha256","bound_context_sha256","result_artifact_sha256","outcome_digest_sha256","original_execution_id_sha256"],
      "properties": {
        "cache_key_sha256":{"$ref":"#/$defs/sha256"},
        "bound_context_sha256":{"$ref":"#/$defs/sha256"},
        "result_artifact_sha256":{"$ref":"#/$defs/sha256"},
        "outcome_digest_sha256":{"$ref":"#/$defs/sha256"},
        "original_execution_id_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "reuseRequest": {
      "type":"object","additionalProperties":false,
      "required":["codebook_is_empty","reuse_semantics","cache_hit_authorized","treat_as_new_independent_sample"],
      "properties": {
        "codebook_is_empty":{"type":"boolean"},
        "reuse_semantics":{"enum":["memoized_same_execution","independent_replication"]},
        "cache_hit_authorized":{"type":"boolean"},
        "treat_as_new_independent_sample":{"type":"boolean"}
      }
    }
  }
}
