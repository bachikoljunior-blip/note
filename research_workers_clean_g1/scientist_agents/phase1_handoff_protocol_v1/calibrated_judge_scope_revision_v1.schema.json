{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/scientist_agents/calibrated_judge_scope_revision_v1.schema.json",
  "title":"Calibrated judge scope and revision gate",
  "type":"object","additionalProperties":false,
  "required":["schema_version","certificate","current_judge","target","claim"],
  "properties":{
    "schema_version":{"const":1},
    "certificate":{"$ref":"#/$defs/certificate"},
    "current_judge":{"$ref":"#/$defs/judge"},
    "target":{"$ref":"#/$defs/target"},
    "claim":{"$ref":"#/$defs/claim"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitsha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "judge":{
      "type":"object","additionalProperties":false,
      "required":["code_revision","runner_sha256","model_identity_sha256","prompt_sha256","rubric_sha256","input_exposure_policy_sha256"],
      "properties":{
        "code_revision":{"$ref":"#/$defs/gitsha"},
        "runner_sha256":{"$ref":"#/$defs/sha256"},
        "model_identity_sha256":{"$ref":"#/$defs/sha256"},
        "prompt_sha256":{"$ref":"#/$defs/sha256"},
        "rubric_sha256":{"$ref":"#/$defs/sha256"},
        "input_exposure_policy_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["sample_n","quadratic_weighted_kappa","within_one_accuracy","human_protocol_sha256","calibration_snapshot_sha256"],
      "properties":{
        "sample_n":{"type":"integer","minimum":1},
        "quadratic_weighted_kappa":{"type":"number","minimum":-1,"maximum":1},
        "within_one_accuracy":{"type":"number","minimum":0,"maximum":1},
        "human_protocol_sha256":{"$ref":"#/$defs/sha256"},
        "calibration_snapshot_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "certificate":{
      "type":"object","additionalProperties":false,
      "required":["judge","metrics","domains","claim_types","certificate_sha256"],
      "properties":{
        "judge":{"$ref":"#/$defs/judge"},
        "metrics":{"$ref":"#/$defs/metrics"},
        "domains":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "claim_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "certificate_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "target":{
      "type":"object","additionalProperties":false,
      "required":["domain","claim_type","input_snapshot_sha256"],
      "properties":{
        "domain":{"type":"string","minLength":1},
        "claim_type":{"type":"string","minLength":1},
        "input_snapshot_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "claim":{
      "type":"object","additionalProperties":false,
      "required":["calibration_status","authority_level","certificate_applied","downstream_human_or_scientific_verification_required"],
      "properties":{
        "calibration_status":{"enum":["calibrated_in_scope","uncalibrated_changed_revision","uncalibrated_out_of_scope"]},
        "authority_level":{"enum":["benchmark_score_support","final_scientific_authority"]},
        "certificate_applied":{"type":"boolean"},
        "downstream_human_or_scientific_verification_required":{"type":"boolean"}
      }
    }
  }
}
