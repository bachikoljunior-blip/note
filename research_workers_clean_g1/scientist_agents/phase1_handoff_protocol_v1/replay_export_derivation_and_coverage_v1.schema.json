{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/replay_export_derivation_and_coverage_v1.schema.json",
  "title": "Replay Export Derivation and Coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim", "canonical_run", "replay_export", "coverage", "authorization"],
  "properties": {
    "schema_version": {"const": 1},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "expected_suite_case_count"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "expected_suite_case_count": {"type": "integer", "minimum": 1}
      }
    },
    "canonical_run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "source_tree_sha256", "model_id", "gate_revision", "canonical_trace_sha256", "structured_record_sha256", "markdown_sha256", "pdf_sha256", "executed_at"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "model_id": {"type": "string", "minLength": 1},
        "gate_revision": {"type": "string", "minLength": 1},
        "canonical_trace_sha256": {"$ref": "#/$defs/sha256"},
        "structured_record_sha256": {"$ref": "#/$defs/sha256"},
        "markdown_sha256": {"$ref": "#/$defs/sha256"},
        "pdf_sha256": {"$ref": "#/$defs/sha256"},
        "executed_at": {"type": "string", "format": "date-time"}
      }
    },
    "replay_export": {
      "type": "object", "additionalProperties": false,
      "required": ["export_revision", "export_builder_sha256", "export_kind", "source_run_id", "source_trace_sha256", "script_sha256", "log_sha256", "paper_sha256", "full_trace", "transformations_sha256", "immutable_export_digest", "timestamp_binding"],
      "properties": {
        "export_revision": {"type": "string", "minLength": 1},
        "export_builder_sha256": {"$ref": "#/$defs/sha256"},
        "export_kind": {"enum": ["presentation_subset", "lossless_archive"]},
        "source_run_id": {"type": "string", "minLength": 1},
        "source_trace_sha256": {"$ref": "#/$defs/sha256"},
        "script_sha256": {"$ref": "#/$defs/sha256"},
        "log_sha256": {"$ref": "#/$defs/sha256"},
        "paper_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "full_trace": {"type": "boolean"},
        "transformations_sha256": {"$ref": "#/$defs/sha256"},
        "immutable_export_digest": {"$ref": "#/$defs/sha256"},
        "timestamp_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "timestamp", "cache_token_semantics_sha256"],
          "properties": {
            "source": {"enum": ["canonical_run_record", "export_metadata", "cache_token"]},
            "timestamp": {"type": "string", "format": "date-time"},
            "cache_token_semantics_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          }
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_suite_case_count", "suite_manifest_sha256", "public_run_ids", "selection_rule_sha256", "suite_case_bindings"],
      "properties": {
        "expected_suite_case_count": {"type": "integer", "minimum": 1},
        "suite_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "public_run_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1},
        "selection_rule_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "suite_case_bindings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["run_id", "canonical_trace_sha256", "source_tree_sha256", "model_id", "gate_revision"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1},
              "canonical_trace_sha256": {"$ref": "#/$defs/sha256"},
              "source_tree_sha256": {"$ref": "#/$defs/sha256"},
              "model_id": {"type": "string", "minLength": 1},
              "gate_revision": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_level"],
      "properties": {
        "requested_level": {"enum": ["presentation_observability", "canonical_run_bound", "suite_bound"]}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
