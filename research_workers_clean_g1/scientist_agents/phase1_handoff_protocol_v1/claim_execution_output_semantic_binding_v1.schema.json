{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/scientist_agents/claim_execution_output_semantic_binding_v1.schema.json",
  "title":"Claim to execution output semantic binding gate",
  "type":"object","additionalProperties":false,
  "required":["schema_version","gate_implementation","execution","outputs","claim","authorization"],
  "properties":{
    "schema_version":{"const":1},
    "gate_implementation":{"$ref":"#/$defs/gate"},
    "execution":{"$ref":"#/$defs/execution"},
    "outputs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/output"}},
    "claim":{"$ref":"#/$defs/claim"},
    "authorization":{"$ref":"#/$defs/authorization"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitsha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "decimal":{"type":"string","pattern":"^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"},
    "gate":{
      "type":"object","additionalProperties":false,
      "required":["repository","revision","edition","gate_blob_sha","policy_revision"],
      "properties":{
        "repository":{"type":"string","minLength":1},
        "revision":{"$ref":"#/$defs/gitsha"},
        "edition":{"type":"string","minLength":1},
        "gate_blob_sha":{"$ref":"#/$defs/gitsha"},
        "policy_revision":{"type":"string","minLength":1}
      }
    },
    "execution":{
      "type":"object","additionalProperties":false,
      "required":["entry_sha256","returncode","timed_out","script_sha256","argv_sha256","input_manifest_sha256","environment_manifest_sha256","output_record_complete"],
      "properties":{
        "entry_sha256":{"$ref":"#/$defs/sha256"},
        "returncode":{"type":"integer"},
        "timed_out":{"type":"boolean"},
        "script_sha256":{"$ref":"#/$defs/sha256"},
        "argv_sha256":{"$ref":"#/$defs/sha256"},
        "input_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "environment_manifest_sha256":{"$ref":"#/$defs/sha256"},
        "output_record_complete":{"type":"boolean"}
      }
    },
    "output":{
      "type":"object","additionalProperties":false,
      "required":["output_id","execution_entry_sha256","field_locator","quantity_id","normalized_value","normalized_unit","record_artifact_sha256"],
      "properties":{
        "output_id":{"type":"string","minLength":1},
        "execution_entry_sha256":{"$ref":"#/$defs/sha256"},
        "field_locator":{"type":"string","minLength":1},
        "quantity_id":{"type":"string","minLength":1},
        "normalized_value":{"$ref":"#/$defs/decimal"},
        "normalized_unit":{"type":"string","minLength":1},
        "record_artifact_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "claim":{
      "type":"object","additionalProperties":false,
      "required":["claim_id","source_output_id","quantity_id","normalized_value","normalized_unit","presented_token","presentation_transform","presentation_transform_digest"],
      "properties":{
        "claim_id":{"type":"string","minLength":1},
        "source_output_id":{"type":"string","minLength":1},
        "quantity_id":{"type":"string","minLength":1},
        "normalized_value":{"$ref":"#/$defs/decimal"},
        "normalized_unit":{"type":"string","minLength":1},
        "presented_token":{"type":"string","minLength":1},
        "presentation_transform":{"enum":["identity","rounding","percent","unit_conversion","rounding_and_unit_conversion"]},
        "presentation_transform_digest":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]}
      }
    },
    "authorization":{
      "type":"object","additionalProperties":false,
      "required":["authority_scope","authorized","authorization_packet_sha256"],
      "properties":{
        "authority_scope":{"const":"scientific_quantitative_claim"},
        "authorized":{"type":"boolean"},
        "authorization_packet_sha256":{"$ref":"#/$defs/sha256"}
      }
    }
  }
}
