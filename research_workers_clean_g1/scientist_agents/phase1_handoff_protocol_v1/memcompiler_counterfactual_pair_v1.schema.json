{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memcompiler_counterfactual_pair_v1.schema.json",
  "title": "MemCompiler fixed-selected-identity receiver-effect counterfactual pair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_scope",
    "varying_dimension",
    "source_trace_path",
    "source_trace_blob_or_sha256",
    "pre_effect_binding",
    "pre_effect_binding_sha256",
    "condition_a",
    "condition_b"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_scope": {
      "enum": [
        "fixed_selected_identity_receiver_effect",
        "fixed_candidate_pool_state_conditioned"
      ]
    },
    "varying_dimension": {
      "type": "string",
      "minLength": 1
    },
    "source_trace_path": {
      "type": "string",
      "minLength": 1
    },
    "source_trace_blob_or_sha256": {
      "type": "string",
      "minLength": 7
    },
    "pre_effect_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pre_effect_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_revision",
        "compiler_artifact_id",
        "compiler_artifact_revision_or_digest",
        "task_id",
        "task_text_sha256",
        "dataset_blob_or_sha256",
        "memory_database_sha256",
        "memory_updates_frozen",
        "retrieval_query_sha256",
        "retrieval_config_sha256",
        "candidate_pool_digest",
        "target_step_index",
        "environment_state_snapshot_sha256",
        "state_revision",
        "state_sha256",
        "brief_state_sha256",
        "selector_policy_revision_or_digest",
        "selected_memory",
        "output_type",
        "compiled_guidance_sha256",
        "selector_output_sha256",
        "executor_policy_revision_or_digest",
        "executor_sampling_config_sha256",
        "rng_state_sha256"
      ],
      "properties": {
        "implementation_revision": {
          "type": "string",
          "minLength": 7
        },
        "compiler_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "compiler_artifact_revision_or_digest": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_blob_or_sha256": {
          "type": "string",
          "minLength": 7
        },
        "memory_database_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "memory_updates_frozen": {
          "type": "boolean"
        },
        "retrieval_query_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieval_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_pool_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_step_index": {
          "type": "integer",
          "minimum": 0
        },
        "environment_state_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_revision": {
          "type": "string",
          "minLength": 1
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "brief_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selector_policy_revision_or_digest": {
          "type": "string",
          "minLength": 1
        },
        "selected_memory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memory_id",
              "content_sha256"
            ],
            "properties": {
              "memory_id": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "output_type": {
          "enum": [
            "EXPERIENCE",
            "BRIEF",
            "HYBRID",
            "NOACTION"
          ]
        },
        "compiled_guidance_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "selector_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executor_policy_revision_or_digest": {
          "type": "string",
          "minLength": 1
        },
        "executor_sampling_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rng_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "condition_a": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "receiver_effect",
        "receiver_effect_payload_sha256",
        "executor_input_sha256",
        "outcome_artifact_sha256"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "receiver_effect": {
          "enum": [
            "inject",
            "abstain"
          ]
        },
        "receiver_effect_payload_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "executor_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "condition_b": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "receiver_effect",
        "receiver_effect_payload_sha256",
        "executor_input_sha256",
        "outcome_artifact_sha256"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "minLength": 1
        },
        "receiver_effect": {
          "enum": [
            "inject",
            "abstain"
          ]
        },
        "receiver_effect_payload_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        },
        "executor_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
