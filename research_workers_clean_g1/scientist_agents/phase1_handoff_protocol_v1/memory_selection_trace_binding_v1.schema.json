{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_selection_trace_binding_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","claim_level","implementation_revision","memory_bank_digest","candidate_pool_digest","memory_updates_frozen","state_digest","selector_policy_digest","manipulated_variable","conditions"],
  "properties": {
    "schema_version": {"const": 1},
    "claim_level": {"enum": ["fixed_candidate_pool_state_conditioned","fixed_selected_identity_acceptance"]},
    "implementation_revision": {"type": "string", "minLength": 1},
    "memory_bank_digest": {"type": "string", "minLength": 1},
    "candidate_pool_digest": {"type": "string", "minLength": 1},
    "memory_updates_frozen": {"type": "boolean"},
    "state_digest": {"type": "string", "minLength": 1},
    "selector_policy_digest": {"type": "string", "minLength": 1},
    "manipulated_variable": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name","selection_trace_available","selected_memory","compiled_guidance_digest","injection_decision"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "selection_trace_available": {"type": "boolean"},
          "selected_memory": {
            "oneOf": [
              {"type": "null"},
              {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id","digest"], "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"type": "string", "minLength": 1}}}}
            ]
          },
          "compiled_guidance_digest": {"type": ["string","null"]},
          "injection_decision": {"enum": ["inject","abstain"]}
        }
      }
    }
  }
}
