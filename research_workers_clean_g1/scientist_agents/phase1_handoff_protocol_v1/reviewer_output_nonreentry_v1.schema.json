{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/scientist_agents/reviewer_output_nonreentry_v1.schema.json",
  "title":"Reviewer output non-reentry gate",
  "type":"object","additionalProperties":false,
  "required":["schema_version","review_mode","snapshot_frozen_before_current_output","input_root_inventory","visible_item_ids","tool_read_policy","output_namespace"],
  "properties":{
    "schema_version":{"const":1},
    "review_mode":{"enum":["primary_independent","meta_comparison"]},
    "snapshot_frozen_before_current_output":{"type":"boolean"},
    "input_root_inventory":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/item"}},
    "visible_item_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "tool_read_policy":{"enum":["root_read_all","allowlist_only"]},
    "output_namespace":{"$ref":"#/$defs/outputNamespace"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "item":{"type":"object","additionalProperties":false,"required":["item_id","producer_class","content_sha256"],"properties":{
      "item_id":{"type":"string","minLength":1},
      "producer_class":{"enum":["agent","harness","reference","evaluator_prior","evaluator_current"]},
      "content_sha256":{"$ref":"#/$defs/sha256"}
    }},
    "outputNamespace":{"type":"object","additionalProperties":false,"required":["disjoint_from_input_root","verdict_artifact_sha256","prompt_artifact_sha256","prior_verdict_visibility_reason"],"properties":{
      "disjoint_from_input_root":{"type":"boolean"},
      "verdict_artifact_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
      "prompt_artifact_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
      "prior_verdict_visibility_reason":{"enum":["not_visible","comparison_only"]}
    }}
  }
}
