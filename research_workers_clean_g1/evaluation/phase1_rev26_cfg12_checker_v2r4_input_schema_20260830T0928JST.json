{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phase1:evaluation:checker-v2r4-rev26:input",
  "title": "Phase-1 checker-v2r4 rev26 executable input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "records",
    "residual_execution_steps",
    "quota_dependencies",
    "incremental_monetary_cost",
    "coverage",
    "continuation",
    "usefulness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "residual_execution_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/residual_execution_step"
      }
    },
    "quota_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quota_dependency"
      },
      "uniqueItems": true
    },
    "incremental_monetary_cost": {
      "type": "number",
      "minimum": 0
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "continuation": {
      "$ref": "#/$defs/continuation"
    },
    "usefulness": {
      "$ref": "#/$defs/usefulness"
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "capability_available",
        "completion_claimed",
        "events"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_available": {
          "type": "boolean"
        },
        "completion_claimed": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "event": {
      "oneOf": [
        {
          "$ref": "#/$defs/commit_effect_event"
        },
        {
          "$ref": "#/$defs/cas_attempt_event"
        },
        {
          "$ref": "#/$defs/retry_event"
        }
      ]
    },
    "commit_effect_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "logical_effect_key",
        "committed"
      ],
      "properties": {
        "event_type": {
          "const": "commit_effect"
        },
        "logical_effect_key": {
          "type": "string",
          "minLength": 1
        },
        "committed": {
          "type": "boolean"
        }
      }
    },
    "cas_attempt_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "cas_key",
        "expected_version",
        "observed_version",
        "won"
      ],
      "properties": {
        "event_type": {
          "const": "cas_attempt"
        },
        "cas_key": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "observed_version": {
          "type": "string",
          "minLength": 1
        },
        "won": {
          "type": "boolean"
        }
      }
    },
    "retry_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "logical_effect_key"
      ],
      "properties": {
        "event_type": {
          "const": "retry"
        },
        "logical_effect_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "residual_execution_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "required_for_completion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "richer_mode",
            "work",
            "protected_primary",
            "manual_user",
            "downstream_execution"
          ]
        },
        "required_for_completion": {
          "type": "boolean"
        }
      }
    },
    "quota_dependency": {
      "enum": [
        "hosted_runner",
        "codespaces",
        "artifact_storage",
        "lfs",
        "package_registry",
        "cloud_compute",
        "cloud_storage",
        "external_api_credit",
        "external_model_credit",
        "monthly_trial_paid_credit"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_roles",
        "completed_without_residual_dependency"
      ],
      "properties": {
        "intended_roles": {
          "type": "integer",
          "minimum": 0
        },
        "completed_without_residual_dependency": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "reconstruction_complete",
        "predecessor_identity_present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "reconstruction_complete": {
          "type": "boolean"
        },
        "predecessor_identity_present": {
          "type": "boolean"
        }
      }
    },
    "usefulness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progress_opportunities",
        "useful_outputs"
      ],
      "properties": {
        "progress_opportunities": {
          "type": "integer",
          "minimum": 0
        },
        "useful_outputs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "x_checker_contract": {
    "hard_gates_evaluated_by_checker": [
      "no residual_execution_steps item with required_for_completion=true",
      "quota_dependencies must be empty for accepted quota-zero route",
      "incremental_monetary_cost must equal 0",
      "completion_claimed=true with capability_available=false must hard reject when unavailable capability is the completion basis",
      "coverage.intended_roles must equal 19 and coverage.completed_without_residual_dependency must equal 19 for positive synthetic controls",
      "continuation.present, continuation.reconstruction_complete and continuation.predecessor_identity_present must all be true for positive controls",
      "duplicate committed logical_effect_key across records must hard reject",
      "CAS attempt with won=true requires expected_version == observed_version; conflicting lineage hard rejects",
      "usefulness.progress_opportunities and usefulness.useful_outputs are strict integers; useful_outputs must not exceed progress_opportunities; when progress_opportunities >= 20, useful_outputs/progress_opportunities must be >= 0.80"
    ],
    "schema_fail_closed_identity_rules": [
      "commit_effect requires nonempty logical_effect_key",
      "cas_attempt requires nonempty cas_key, expected_version and observed_version",
      "fractional/non-integer usefulness counts are invalid before checker evaluation"
    ],
    "scope": "Synthetic evaluation-control input only. The schema does not source or assert live other-role semantics and cannot establish root acceptance by itself."
  }
}
