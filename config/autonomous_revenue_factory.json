{
  "schema_version": "1.0",
  "classification": "assistant_created_mutable_policy_config",
  "enabled": true,
  "objective": "minimize_total_elapsed_time_to_verified_monthly_revenue_yen_200000",
  "preferred_host": "chatgpt_sites",
  "max_concurrent_builds": 1,
  "selection_metric": "expected_monthly_revenue_contribution_divided_by_total_elapsed_time",
  "state_path": "state/autonomous_revenue_factory.json",
  "policy_path": "OPERATIONS/AUTONOMOUS_REVENUE_FACTORY.md",
  "validation_script": "scripts/check_autonomous_revenue_factory.py",
  "autonomous_build_gate": {
    "additional_cost_yen_must_equal": 0,
    "requires_new_contract": false,
    "requires_identity_verification": false,
    "requires_payment_or_bank_details": false,
    "requires_tax_information": false,
    "uses_only_verified_source_facts": true,
    "contains_personal_or_secret_data": false,
    "build_and_link_qa_required": true,
    "rollback_or_disable_required": true,
    "other_existing_repository_write_allowed": false
  },
  "publication_gate": {
    "all_build_gate_checks_required": true,
    "provider_and_runtime_approval_required": true,
    "retry_after_explicit_denial_without_new_authority": false,
    "denial_action": "preserve_private_deployment_record_blocker_and_continue_other_work"
  },
  "measurement": {
    "utm_required": true,
    "inferred_metrics_allowed": false,
    "missing_analytics_is_stop_condition": false
  }
}
